// Windows resource file. Exposes the app icon and version metadata for the .exe.

#include <winver.h>

#define IDI_APP_ICON 101
IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    DENTAL_VERSION_MAJOR,DENTAL_VERSION_MINOR,DENTAL_VERSION_PATCH,0
 PRODUCTVERSION DENTAL_VERSION_MAJOR,DENTAL_VERSION_MINOR,DENTAL_VERSION_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904B0"
    {
      VALUE "CompanyName",      "Dental Patients\0"
      VALUE "FileDescription",  "Dental Patients - Persian patient records manager\0"
      VALUE "FileVersion",      DENTAL_VERSION_STRING "\0"
      VALUE "InternalName",     "DentalPatients\0"
      VALUE "OriginalFilename", "DentalPatients.exe\0"
      VALUE "ProductName",      "Dental Patients\0"
      VALUE "ProductVersion",   DENTAL_VERSION_STRING "\0"
    }
  }
  BLOCK "VarFileInfo" { VALUE "Translation", 0x409, 0x4B0 }
}
